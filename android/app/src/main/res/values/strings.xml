    <!-- Lesson Items -->
    <string name="lesson_1_title">Find Middle C</string>
    <string name="lesson_1_desc">The central home base of the piano keyboard.</string>
    <string name="lesson_1_inst">Middle C (C4) is located directly to the left of the group of two black keys near the center. Press Middle C to start!</string>

    <string name="lesson_2_title">The First Trio: C, D, E</string>
    <string name="lesson_2_desc">Learn your first three consecutive white keys.</string>
    <string name="lesson_2_inst">Place your fingers on C4, D4, and E4. Play them in order from left to right: C -> D -> E.</string>

    <string name="lesson_3_title">Black Keys: C# and D#</string>
    <string name="lesson_3_desc">Discover sharps and the distinctive twin black keys.</string>
    <string name="lesson_3_inst">The two black keys above C and D are C# (sharp) and D#. Play C4, C#4, D4, D#4.</string>

    <string name="lesson_4_title">5-Finger Pentascale (C–G)</string>
    <string name="lesson_4_desc">Use all five fingers on one position.</string>
    <string name="lesson_4_inst">Assign Thumb (1) to C, Index (2) to D, Middle (3) to E, Ring (4) to F, Pinky (5) to G. Play C -> D -> E -> F -> G.</string>

    <string name="lesson_5_title">Ode to Joy Theme</string>
    <string name="lesson_5_desc">Play Beethoven\'s beloved melody using the 5-finger position.</string>
    <string name="lesson_5_inst">Play the opening phrase: E -> E -> F -> G -> G -> F -> E -> D.</string>

    <string name="lesson_6_title">Bass C &amp; Low Register</string>
    <string name="lesson_6_desc">Anchor your left hand an octave lower.</string>
    <string name="lesson_6_inst">Look one octave to the left for Bass C (C3). Press C3 with your left hand pinky.</string>

    <string name="lesson_7_title">The Power of the 5th (C &amp; G)</string>
    <string name="lesson_7_desc">The foundational accompaniment interval in modern music.</string>
    <string name="lesson_7_inst">Play Bass C (C3) followed by Bass G (G3): low and resonant!</string>

    <string name="lesson_8_title">Two-Hand Synchronization</string>
    <string name="lesson_8_desc">Combine Left Hand Bass with Right Hand Melody.</string>
    <string name="lesson_8_inst">Play C3 with Left Hand, then C4 with Right Hand: C3 -> C4 -> G3 -> G4.</string>

    <string name="lesson_9_title">The C Major Triad</string>
    <string name="lesson_9_desc">The most famous chord in Western harmony.</string>
    <string name="lesson_9_inst">Play C4, E4, and G4 in sequence to build the C Major chord: C -> E -> G.</string>

    <string name="lesson_10_title">The G Major Triad</string>
    <string name="lesson_10_desc">The dominant chord that always resolves back to C.</string>
    <string name="lesson_10_inst">Play G3, B3, and D4: G -> B -> D.</string>

    <string name="lesson_11_title">Canon in D Mastery</string>
    <string name="lesson_11_desc">Play Pachelbel\'s descending bassline and harmony.</string>
    <string name="lesson_11_inst">Play the iconic progression notes: D -> C# -> B -> A.</string>

    <string name="lesson_12_title">Für Elise Signature Hook</string>
    <string name="lesson_12_desc">Beethoven\'s unforgettable alternating motif.</string>
    <string name="lesson_12_inst">Play the famous phrase: E5 -> D#5 -> E5 -> D#5 -> E5 -> B4 -> D5 -> C5 -> A4.</string>

