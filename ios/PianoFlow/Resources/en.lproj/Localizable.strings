/* Lesson Items */
"lesson_1_title" = "Find Middle C";
"lesson_1_desc" = "The central home base of the piano keyboard.";
"lesson_1_inst" = "Middle C (C4) is located directly to the left of the group of two black keys near the center. Press Middle C to start!";

"lesson_2_title" = "The First Trio: C, D, E";
"lesson_2_desc" = "Learn your first three consecutive white keys.";
"lesson_2_inst" = "Place your fingers on C4, D4, and E4. Play them in order from left to right: C -> D -> E.";

"lesson_3_title" = "Black Keys: C# and D#";
"lesson_3_desc" = "Discover sharps and the distinctive twin black keys.";
"lesson_3_inst" = "The two black keys above C and D are C# (sharp) and D#. Play C4, C#4, D4, D#4.";

"lesson_4_title" = "5-Finger Pentascale (C–G)";
"lesson_4_desc" = "Use all five fingers on one position.";
"lesson_4_inst" = "Assign Thumb (1) to C, Index (2) to D, Middle (3) to E, Ring (4) to F, Pinky (5) to G. Play C -> D -> E -> F -> G.";

"lesson_5_title" = "Ode to Joy Theme";
"lesson_5_desc" = "Play Beethoven's beloved melody using the 5-finger position.";
"lesson_5_inst" = "Play the opening phrase: E -> E -> F -> G -> G -> F -> E -> D.";

"lesson_6_title" = "Bass C & Low Register";
"lesson_6_desc" = "Anchor your left hand an octave lower.";
"lesson_6_inst" = "Look one octave to the left for Bass C (C3). Press C3 with your left hand pinky.";

"lesson_7_title" = "The Power of the 5th (C & G)";
"lesson_7_desc" = "The foundational accompaniment interval in modern music.";
"lesson_7_inst" = "Play Bass C (C3) followed by Bass G (G3): low and resonant!";

"lesson_8_title" = "Two-Hand Synchronization";
"lesson_8_desc" = "Combine Left Hand Bass with Right Hand Melody.";
"lesson_8_inst" = "Play C3 with Left Hand, then C4 with Right Hand: C3 -> C4 -> G3 -> G4.";

"lesson_9_title" = "The C Major Triad";
"lesson_9_desc" = "The most famous chord in Western harmony.";
"lesson_9_inst" = "Play C4, E4, and G4 in sequence to build the C Major chord: C -> E -> G.";

"lesson_10_title" = "The G Major Triad";
"lesson_10_desc" = "The dominant chord that always resolves back to C.";
"lesson_10_inst" = "Play G3, B3, and D4: G -> B -> D.";

"lesson_11_title" = "Canon in D Mastery";
"lesson_11_desc" = "Play Pachelbel's descending bassline and harmony.";
"lesson_11_inst" = "Play the iconic progression notes: D -> C# -> B -> A.";

"lesson_12_title" = "Für Elise Signature Hook";
"lesson_12_desc" = "Beethoven's unforgettable alternating motif.";
"lesson_12_inst" = "Play the famous phrase: E5 -> D#5 -> E5 -> D#5 -> E5 -> B4 -> D5 -> C5 -> A4.";

