/* Lesson Items */
"lesson_1_title" = "Tìm nốt Đô giữa (C4)";
"lesson_1_desc" = "Điểm tựa trung tâm trên bàn phím piano.";
"lesson_1_inst" = "Nốt C4 (Đô4) nằm ngay bên trái cụm hai phím đen ở giữa đàn. Hãy bấm phím C4 để bắt đầu!";

"lesson_2_title" = "Bộ ba đầu tiên: C, D, E";
"lesson_2_desc" = "Làm quen với ba phím trắng liên tiếp đầu tiên.";
"lesson_2_inst" = "Đặt ngón tay lên C4, D4 và E4. Bấm lần lượt từ trái sang phải: C -> D -> E.";

"lesson_3_title" = "Phím đen: C# và D#";
"lesson_3_desc" = "Khám phá dấu thăng và cụm hai phím đen đặc trưng.";
"lesson_3_inst" = "Hai phím đen phía trên C và D là C# và D#. Hãy bấm lần lượt C4, C#4, D4, D#4.";

"lesson_4_title" = "Ngũ âm 5 ngón (C–G)";
"lesson_4_desc" = "Sử dụng đồng đều cả năm ngón tay trên một vị trí.";
"lesson_4_inst" = "Đặt ngón Cái (1) vào C, Trỏ (2) vào D, Giữa (3) vào E, Áp út (4) vào F, Út (5) vào G. Bấm C -> D -> E -> F -> G.";

"lesson_5_title" = "Giai điệu Ode to Joy";
"lesson_5_desc" = "Chơi giai điệu bất hủ của Beethoven bằng thế tay 5 ngón.";
"lesson_5_inst" = "Chơi câu nhạc mở đầu: E -> E -> F -> G -> G -> F -> E -> D.";

"lesson_6_title" = "Đô trầm (C3) & Âm vực thấp";
"lesson_6_desc" = "Đặt tay trái thấp hơn một quãng tám để giữ nhịp nền.";
"lesson_6_inst" = "Tìm nốt C3 (Đô3) lệch về bên trái một quãng tám. Bấm C3 bằng ngón út tay trái.";

"lesson_7_title" = "Sức mạnh quãng 5 (C & G)";
"lesson_7_desc" = "Quãng đệm nền tảng trong âm nhạc hiện đại.";
"lesson_7_inst" = "Chơi nốt trầm C3 rồi đến G3 để cảm nhận độ vang đầy đặn!";

"lesson_8_title" = "Phối hợp hai tay";
"lesson_8_desc" = "Kết hợp âm trầm tay trái với giai điệu tay phải.";
"lesson_8_inst" = "Bấm C3 bằng tay trái, tiếp theo C4 bằng tay phải: C3 -> C4 -> G3 -> G4.";

"lesson_9_title" = "Hợp âm Đô trưởng (C Major)";
"lesson_9_desc" = "Hợp âm ba phổ biến nhất trong hòa âm phương Tây.";
"lesson_9_inst" = "Bấm lần lượt C4, E4 và G4 để tạo thành hợp âm Đô trưởng: C -> E -> G.";

"lesson_10_title" = "Hợp âm Sol trưởng (G Major)";
"lesson_10_desc" = "Hợp âm át luôn dẫn giai điệu quay về C.";
"lesson_10_inst" = "Bấm lần lượt G3, B3 và D4: G -> B -> D.";

"lesson_11_title" = "Tinh hoa Canon in D";
"lesson_11_desc" = "Chơi tuyến giai điệu đi xuống kinh điển của Pachelbel.";
"lesson_11_inst" = "Bấm chuỗi nốt đặc trưng: D -> C# -> B -> A.";

"lesson_12_title" = "Đoạn mở đầu Für Elise";
"lesson_12_desc" = "Mô-típ luân phiên khó quên của Beethoven.";
"lesson_12_inst" = "Chơi câu nhạc nổi tiếng: E5 -> D#5 -> E5 -> D#5 -> E5 -> B4 -> D5 -> C5 -> A4.";

